# PostgreSQL
POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST_PORT=5432
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# MinIO local credentials
MINIO_ROOT_USER=minio-local
MINIO_ROOT_PASSWORD=change-me-local-only

# S3 settings
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET_NAME=catalog-images
S3_ACCESS_KEY=minio-local
S3_SECRET_KEY=change-me-local-only
S3_REGION=us-east-1

# Telegram bot and API secrets
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
TELEGRAM_WEBHOOK_SECRET=
API_SERVICE_TOKEN=

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true
API_LOG_DIR=logs/api
BOT_LOG_DIR=logs/bot
LOG_MAX_BYTES=10485760
LOG_MAX_FILES=5

# API client
API_BASE_URL=http://127.0.0.1:8000

# Mini App
MINI_APP_URL=https://example.com/catalog
